---
import { Image } from "astro:assets";
import svgl from "../../public/svgl.png";
import stockin from "../../public/stockin.png";


import vtex1 from "../../public/vtex-1.png"
import vtex2 from "../../public/vtex-2.png"
import vtex3 from "../../public/vtex-3.jpg"

interface Project {
  title: string;
  image: ImageMetadata;

  status: string;
}

const certificaciones: Project[] = [
  {
    title: "VTEX TRAINING bloque 1",
    image: vtex1 as ImageMetadata,
    status: "Inicios VTEX IO",
  },
  {
    title: "VTEX TRAINING Bloque 2",
    image: vtex2 as ImageMetadata,
    status: "Contextos VTEX IO",
  },
  {
    title: "VTEX TRAINING Bloque 3",
    image: vtex3 as ImageMetadata,
    status: "Microservicios en VTEX IO",
  },
  
  // {
  //   title: "Mucho mas que palabras",
  //   image: velez as ImageMetadata,
  //   link: "https://github.com/Buga-Software/rifasvelez-web",
  //   preview: "https://www.doce34.cl/",
  //   status: "Deployed",
  // },
];
---

<section
  id="certificaciones"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <!-- <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Mi trabajo</h2> -->
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Certificaciones</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        certificaciones.map((project) => (
          <div class="group">
          
              <div class="rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300 mb-4">
                <Image
                  src={project.image}
                  alt={project.title}
                  class="w-full h-100 md:h-100 object-cover  transition-transform duration-300"
                />
              </div>
              <div class="flex items-center px-3">
                <div class="flex-grow">
                  <h4 class="text-2xl uppercase font-semibold">{project.title}</h4>
                
                </div>
                <div class="flex gap-2 ml-auto">
                
               
                </div>
              </div>
          
          </div>
        ))
      }
    </div>
    
  </div>
</section>
